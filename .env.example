# LIMITLESS AI CORE — server-side provider credentials.
# Copy to .env.local and fill in the providers you have access to.
# Never prefix these with NEXT_PUBLIC_: they must stay on the server.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional: caps how many provider attempts a single request may use.
AI_MAX_ATTEMPTS=3

# Public origin used in metadata (set after a custom domain is connected).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
